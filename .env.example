# Telegram bot token from BotFather (required)
BOT_TOKEN=your_token_here

# The exchange group's chat ID (required)
GROUP_CHAT_ID=-1001234567890

# SQLite database file location
DB_PATH=./data/bot.sqlite

# Trigger words for karma detection (comma-separated, whole-word, case-insensitive)
KARMA_TRIGGERS=обменялись

# Per-pair karma cooldown window in hours
KARMA_DEDUP_HOURS=24

# Post a confirmation in group when karma is credited (true/false)
KARMA_ANNOUNCE=false

# Default language for UI
DEFAULT_LANGUAGE=en

# Support contact handle shown in replies
SUPPORT_CONTACT=@apalevich
